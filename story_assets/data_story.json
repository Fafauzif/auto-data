      "id": "DATA_STORY_04",
      "title": "Four charging counts mean four different things",
      "takeaway": "A site count is not a capacity measure.",
      "body": "The same source contains 2,454 station records, 3,767 charger-box records, 7,593 reconstructed charger units and 4,665 connectors. These quantities describe different levels of the source data. They cannot be added or substituted for one another. None tells us how many compatible vehicles can charge at once today. Choosing a different unit can also change provincial rankings.",
      "chart": {
        "type": "unit_cards",
        "title": "Keep each number attached to its unit",
        "cards": [
          {
            "label": "Station records",
            "value": 2454,
            "display": "2,454",
            "meaning": "Consolidated source locations"
          },
          {
            "label": "Charger-box records",
            "value": 3767,
            "display": "3,767",
            "meaning": "Separate hardware records"
          },
          {
            "label": "Source charger units",
            "value": 7593,
            "display": "7,593",
            "meaning": "Counts reconstructed by the source"
          },
          {
            "label": "Source connectors",
            "value": 4665,
            "display": "4,665",
            "meaning": "Recorded connector counts"
          }
        ],
        "do_not_stack_or_sum": true,
        "do_not_label_capacity": true
      },
      "supporting_cards": [
